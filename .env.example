# Copy this file to .env and fill in the values.

# Postgres connection string, used locally and in production alike — there is no
# local-file database mode, so this must always point at a real Postgres.
# Hosted providers (Neon, Supabase, Vercel Postgres) hand you this URL. On
# serverless platforms, prefer their *pooled* connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Google sign-in. The button is always on the sign-in page; without these it
# tells whoever presses it that the server isn't set up, and email and password
# keep working regardless. Create an OAuth 2.0 Client ID of
# type "Web application" at https://console.cloud.google.com/apis/credentials
# and add every origin you serve from as an authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback
#   https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Outbound email, via Resend (https://resend.com). Two things use it: password
# reset links, and the message every new account gets telling it how to sign in.
#
# Without both of these, everything still works — /forgot says so and points
# people at their trainer, and a trainer adding a client is shown the password
# to pass on by hand, exactly as before there was any mail at all.
#
# MAIL_FROM must be an address on a domain you've verified with Resend; their
# onboarding@resend.dev sender only delivers to the address that owns the Resend
# account, so it's for testing and nothing else.
RESEND_API_KEY=""
MAIL_FROM="Chalkline <no-reply@your-domain.com>"

# Owner-only admin area at /admin: every account, the sign-in log, and what each
# account has built. Comma-separated emails, matched against the signed-in
# account. Leave blank and /admin returns 404 for everyone, including you.
#
# These are the owners. Owners can promote a trainer to admin from the account's
# page, which grants the same area but not the ability to promote anyone else —
# so the top of the tree only ever moves by editing this variable.
ADMIN_EMAILS=""

# Reading a photo of a meal into food rows, via Google's Gemini API. Get a key
# for free at https://aistudio.google.com/apikey.
#
# Without it, the "Photo of food" button still appears and says plainly that
# it isn't set up — scanning a barcode, picking from the food catalog and
# typing a meal in by hand are all unaffected. Nothing else in the app reads
# this.
#
# Worth knowing before you switch it on: the photo is never stored by this app
# — it exists as a variable for the length of one request and is never written
# anywhere — but on Google's *free* tier, Google may retain what you send and
# use it to improve their products. Your athletes' meal photos go with it. A
# billed Google Cloud project excludes prompts from that; the code is the same
# either way, only the key changes.
GEMINI_API_KEY=""

# The daily digest email — one summary per trainer per day, at the hour they
# pick on their dashboard, covering finished sessions and logged food.
#
# It's driven by a scheduler hitting /api/cron/digest, which has no session
# cookie to authenticate with, so it carries this secret as a bearer token
# instead. Leave it blank and that endpoint is a 404 for everyone, including
# the scheduler, and no digests go out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Set the same value wherever the scheduler lives. The repo ships
# .github/workflows/digest.yml, which needs it as a repository *secret* named
# CRON_SECRET plus a repository *variable* named APP_URL. See the README for
# why it isn't a Vercel cron.
CRON_SECRET=""

# Only needed if the public URL isn't the origin requests arrive on (a tunnel,
# an unusual proxy). The redirect URI is built from this when set.
# APP_URL="https://your-domain.com"
