// Personal training app — data model
// Postgres everywhere: the same provider locally and in production, so what
// works in dev is what deploys. Note: role/status/type stay String fields with
// app-level constants (see src/lib/constants.ts) rather than native enums.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  email String @unique
  // Null for accounts that only ever signed in with Google. Every read has to
  // treat "no password" as a real state, not a broken row.
  passwordHash String?
  // Google's `sub` claim — stable for the lifetime of the Google account, and
  // unlike the email address it never gets reassigned, so it's the identity we
  // match on once an account is linked.
  googleId String? @unique
  name     String
  role     String   @default("CLIENT") // TRAINER | CLIENT
  createdAt DateTime @default(now())

  // How this account came to exist. Existing rows all default to SELF, which is
  // right for everyone who registered but wrong for clients a trainer added —
  // only new rows are accurate.
  signupSource String @default("SELF") // SELF | GOOGLE | TRAINER
  // Denormalised from the newest successful LoginEvent so the admin list can
  // sort and display "last seen" without a per-row subquery.
  lastLoginAt DateTime?

  // Granted by an owner from /admin, and the reason admin isn't a third value
  // of `role`: it's an overlay on an ordinary trainer account, so promoting
  // someone doesn't disturb the coaching they were already doing. Owners
  // themselves are named in ADMIN_EMAILS and never rely on this column, which
  // keeps the root of the permission tree outside the database (see
  // src/lib/admin.ts).
  isAdmin Boolean @default(false)

  // Bumped every time the password changes. The session token carries the epoch
  // it was minted with and getCurrentUser() rejects a mismatch, which is the
  // only thing that makes a reset mean anything: sessions are stateless JWTs
  // with a thirty-day life, so without this, resetting the password of an
  // account someone else is sitting in leaves them signed in for a month.
  // Deliberately the same mechanism as the role check that already lives there.
  sessionEpoch Int @default(0)

  // IANA zone name as the browser reports it ("America/New_York"). Nothing in
  // the app's own date handling reads this — dates stay local-midnight plus a
  // minute count, see CalendarEvent below — and adding it changes none of that.
  // It exists because Google Calendar won't accept a wall-clock time without a
  // zone to interpret it in, and the honest answer to "whose 9am is this?" is
  // not the server's. Null until the browser has reported one.
  timeZone String?

  // Which units this person reads numbers in — METRIC | IMPERIAL. A viewer
  // preference, not a property of whoever is being measured: a coach with
  // twenty athletes wants one unit across the whole roster, and an athlete
  // wants the one their bathroom scale shows. Bodies are stored canonical
  // metric (see ClientProfile), so this only ever decides rendering.
  //
  // On User rather than in a cookie like the appearance settings, whose own
  // comment in theme-actions.ts gives three reasons that each fail here: this
  // isn't a device preference (the same coach wants kilos on their phone and
  // their laptop), it has no pre-database read (every page that shows a weight
  // already has a user in hand), and nothing in the root layout renders a
  // number, so there is no flash to avoid. On User rather than on
  // ClientProfile because trainers have no profile and still read the numbers.
  units String @default("METRIC")

  // Which hour of the trainer's own day the digest goes out at, 0-23; null is
  // off. Deliberately NOT the minutes-from-midnight the rest of the app uses
  // for times (see CalendarEvent): the scheduler that fires this runs hourly,
  // so a minute field would promise a precision it cannot keep, and someone
  // would set 20:30 and file a bug about the half hour. Read against timeZone
  // above, which is the only reason that column now has a second caller.
  //
  // Defaulted rather than null so an existing trainer gets a digest without
  // finding a setting first — the same call GoogleCalendarCard makes about
  // discoverability. Turning it off is then a deliberate choice, which is the
  // right way round for something that only ever sends one email a day.
  digestHour Int? @default(20)

  // Opt in to hearing about a finished session the moment it lands, instead of
  // waiting for the digest. Off by default: the digest exists precisely so a
  // coach with twenty clients isn't interrupted all day, so choosing to be
  // interrupted should be the deliberate half.
  instantWorkoutEmail Boolean @default(false)

  // The same opt-in for food logs, and the noisier of the two by a wide margin.
  // A workout completes once, so instantWorkoutEmail means one email per
  // session; a day's log is upserted every time the athlete adds a food, so
  // this means one email per *save*. saveNutritionLog's own comment puts that
  // at four or five a day per athlete. Off by default like its neighbour, and
  // the card says plainly what it costs.
  instantNutritionEmail Boolean @default(false)

  // All three of the above sit on User rather than in a side table, unlike
  // GoogleCalendarConnection. The hazard that one avoids is a *secret* being
  // loaded by getCurrentUser()'s select-less findUnique and ending up one
  // careless `<Foo user={user} />` from a client bundle. These are non-secret
  // scalars in the same class as timeZone and isAdmin, and the settings card is
  // supposed to render them.

  // When this account's profile photo was last written; null means it has none.
  // The bytes themselves are in ProfilePhoto below, for exactly the reason the
  // paragraph above gives — but the *marker* has to stay here, because every
  // page that draws an avatar already loads whole user rows and would otherwise
  // need a join added to each of its queries to find out whether to draw one.
  // Denormalised in the same spirit as lastLoginAt, and cheap for the same
  // reason: eight bytes, not fifteen kilobytes.
  //
  // It doubles as the cache-busting version in the photo URL (see
  // src/lib/avatar.ts). The bytes are immutable for a given value of this, so
  // the image can be served immutable and a new photo simply has a new URL.
  photoUpdatedAt DateTime?

  // A client belongs to one trainer (self-relation).
  trainerId String?
  trainer   User?   @relation("TrainerClients", fields: [trainerId], references: [id])
  clients   User[]  @relation("TrainerClients")

  workoutsAsClient  Workout[] @relation("ClientWorkouts")
  workoutsAsTrainer Workout[] @relation("TrainerWorkouts")

  feedItemsAsTrainer FeedItem[] @relation("TrainerFeed")
  feedItemsAsClient  FeedItem[] @relation("ClientFeed")

  // Reusable, client-agnostic building blocks a trainer owns.
  templates          WorkoutTemplate[] @relation("TrainerTemplates")
  programs           Program[]         @relation("TrainerPrograms")
  exerciseNames      TrainerExercise[] @relation("TrainerExercises")
  nutritionTemplates NutritionPlan[]   @relation("TrainerNutrition")
  // Nutrition plans assigned down to this user (as a client).
  nutritionPlans     NutritionPlan[]   @relation("ClientNutrition")
  // What this user actually ate, as a client. The other half of the loop:
  // nutritionPlans above is what the coach prescribed.
  nutritionLogs      NutritionLog[]    @relation("ClientNutritionLogs")

  digestRuns DigestRun[] @relation("TrainerDigests")

  // Conversations. `threads` is every thread this user is *in*, whichever role
  // they hold in it; `threadsAsTrainer` is the narrower set they own. Both are
  // needed: an athlete reads their inbox through the first, and a coach's
  // "start a thread" writes through the second.
  threads          ThreadParticipant[] @relation("UserThreads")
  threadsAsTrainer Thread[]            @relation("TrainerThreads")
  messagesSent     Message[]           @relation("SentMessages")

  // The scheduled messages this coach wrote, and the ones naming this athlete
  // as a recipient.
  broadcasts            Broadcast[]          @relation("TrainerBroadcasts")
  broadcastsAsRecipient BroadcastRecipient[] @relation("ClientBroadcasts")

  // The trainer's own calendar entries, and the ones that name this user as the
  // client they're about.
  eventsAsTrainer CalendarEvent[] @relation("TrainerEvents")
  eventsAsClient  CalendarEvent[] @relation("ClientEvents")

  logins LoginEvent[] @relation("UserLogins")

  resets PasswordResetToken[] @relation("UserResets")

  googleCalendar GoogleCalendarConnection? @relation("UserGoogleCalendar")

  photo ProfilePhoto? @relation("UserPhoto")

  // The intake file and the weigh-ins behind it. Both are client-side only —
  // a trainer has neither, which is half the reason the profile isn't a set of
  // columns on this model.
  bodyProfile  ClientProfile? @relation("UserBodyProfile")
  measurements Measurement[]  @relation("ClientMeasurements")
}

// Everything a coach needs before they can write a meal plan or a training
// block: the facts that don't move week to week (sex, date of birth, height)
// and the ones that change with a conversation rather than a scale (the goal,
// the equipment, the injuries, how they eat).
//
// Its own table rather than columns on User, for the reason ProfilePhoto and
// GoogleCalendarConnection both give: getCurrentUser() does a findUnique with
// no `select`, so every column of User is loaded on every authenticated
// request in the app. Seventeen intake columns — several of them
// health-adjacent — would ride along on all of them. User also carries both
// roles, so those columns would be permanently null for every coach, and "not
// intaked yet" is a far more honest state as one absent row than as seventeen
// nulls that individually mean nothing.
//
// Nothing here is denormalised from Measurement. Current weight is the newest
// measurement — one lookup down an index we need anyway — not a column that
// every insert, edit and delete has to remember to keep true.
//
// Masses and lengths are canonical metric and unrounded. Whether they read as
// pounds and inches is decided at render from User.units, so one file is
// legible to a coach in kg and an athlete in lb without a second copy of the
// numbers. See src/lib/units.ts for why rounding on write would quietly
// corrupt the round trip.
model ClientProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("UserBodyProfile", fields: [userId], references: [id], onDelete: Cascade)

  // The metabolic input to Mifflin–St Jeor (src/lib/body.ts), which is the only
  // thing that reads it — the form says exactly that under the field. Nullable
  // because "never asked" has to stay distinguishable from an answer: the
  // calorie suggestion refuses to compute rather than picking one.
  sex String? // MALE | FEMALE

  // Local-midnight, the same convention as Workout.scheduledDate. Age is
  // derived at read time and never stored: a stored age is wrong within a year
  // and would silently drift every calorie suggestion downstream of it.
  birthDate DateTime?

  heightCm Float?

  // How much the rest of their life moves. SEDENTARY | LIGHT | MODERATE |
  // ACTIVE | VERY_ACTIVE; the label lives in constants.ts and the multiplier it
  // stands for in body.ts. Deliberately the *only* input to the TDEE
  // multiplier — trainingDaysPerWeek below is programming context, and feeding
  // both into the same number counts the training twice.
  activityLevel String?

  goalType     String? // LOSE | MAINTAIN | GAIN
  goalWeightKg Float?

  // Always a positive magnitude; direction is goalType's job. A signed rate
  // would let goalType GAIN and a negative rate disagree, and one of the two
  // would have to win silently.
  rateKgPerWeek Float?

  // Programming context, read by the coach writing the block rather than by any
  // formula. 0 is a real answer for someone who hasn't started.
  trainingDaysPerWeek Int?
  experience          String? // BEGINNER | INTERMEDIATE | ADVANCED

  // Both, because either alone is useless. The closed set is what a program
  // filter would ever key on and is one tap at intake; the prose is what
  // actually decides the session ("adjustable dumbbells to 24kg, no rack").
  trainingLocation String? // COMMERCIAL_GYM | HOME_GYM | MINIMAL | OUTDOORS
  equipmentNotes   String?

  // Free text and nothing else. "Left shoulder, no overhead pressing, cleared
  // for landmine work" is a sentence, and every attempt to make it a list
  // throws away the half that changes the programming.
  injuries String?

  // Allergies are kept apart from preferences on purpose: one is a safety fact
  // and the other is taste. A single "dietary notes" box puts a nut allergy in
  // the same paragraph as not liking mushrooms, and the plan builder has no way
  // to tell them apart again.
  dietPattern  String? // OMNIVORE | VEGETARIAN | VEGAN | PESCATARIAN | OTHER
  allergies    String?
  dietaryNotes String?

  // The one number that turns a macro target into a meal plan.
  mealsPerDay Int?

  // Everything else that belongs in front of the coach: shift work, a 5am
  // training window, what they're actually training for.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One weigh-in. The time-series half of intake — the figures that only mean
// anything as a sequence — kept apart from ClientProfile, which is the facts
// that don't move.
//
// Shaped after NutritionLog, deliberately: one row per client per day on
// @@unique([clientId, date]), so re-recording a day edits it instead of
// stacking a second entry, with the date stored local-midnight like every other
// day-valued date here. That unique index is also the whole read path — the
// trend query is `where clientId, orderBy date desc`, exactly the prefix it
// indexes — which is why there is no second index on this table. When the
// digest learns to report weigh-ins it will want [clientId, updatedAt], the one
// NutritionLog carries, and that is the moment to add it rather than now.
//
// Every figure is nullable, including the weight: a tape-only entry is a real
// thing a coach records. A row with nothing in it at all is refused by the
// parser (src/lib/body-form.ts), not by the column types.
model Measurement {
  id String @id @default(cuid())

  clientId String
  client   User   @relation("ClientMeasurements", fields: [clientId], references: [id], onDelete: Cascade)

  date DateTime

  weightKg   Float?
  bodyFatPct Float?

  // The seven tape sites, in the order the form and the table both render them
  // — TAPE_SITES in constants.ts owns that order, so the two can't drift apart.
  // Columns rather than a JSON blob: it's a fixed set that gets charted and
  // diffed, and each one wants to be queryable the day someone asks for a waist
  // trend.
  neckCm  Float?
  chestCm Float?
  waistCm Float?
  hipsCm  Float?
  thighCm Float?
  armCm   Float?
  calfCm  Float?

  // "First thing, after a bad week of sleep." The context that makes a jump
  // legible — exactly the job NutritionLog.notes does for a day of food.
  notes String?

  // TRAINER | CLIENT — who put the number in. Not cosmetic: a coach reads their
  // own tape reading differently from a figure an athlete typed off a bathroom
  // scale, and it's the only signal self-logging will ever produce about
  // whether it gets used. The same call LoggedFood.source makes.
  source String @default("TRAINER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, date])
}

// A profile photo, one row per account that has uploaded one. Its own table for
// the same decisive reason GoogleCalendarConnection gives below: getCurrentUser()
// does a findUnique with no `select`, so a Bytes column on User would be read out
// of the database and into memory on every authenticated request in the app, to
// be thrown away by all but one of them. Nothing loads this table except the
// route handler that serves the image.
//
// The photo is written already resized — a 256px square, ~15KB — by the browser,
// and the server refuses anything over MAX_PHOTO_BYTES (src/lib/avatar.ts). One
// row per user, keyed by userId rather than its own cuid, so replacing a photo
// overwrites and nothing can accumulate.
model ProfilePhoto {
  userId String @id
  user   User   @relation("UserPhoto", fields: [userId], references: [id], onDelete: Cascade)

  data Bytes
  // Whatever the browser's canvas actually produced: WebP everywhere current,
  // JPEG where toBlob wouldn't encode WebP. Stored rather than assumed, because
  // it's what the Content-Type header has to say.
  contentType String

  updatedAt DateTime @updatedAt
}

// One row per account that has connected Google Calendar. Its own table rather
// than columns on User for one decisive reason: getCurrentUser() does a
// findUnique with no `select`, so every column of User is loaded into memory on
// every authenticated request in the app. A refresh token there would be one
// careless `<Foo user={user} />` away from being serialised into a client
// bundle. Nothing reads this table unless a sync is actually running.
model GoogleCalendarConnection {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("UserGoogleCalendar", fields: [userId], references: [id], onDelete: Cascade)

  // Which Google account this is. Shown on the card, and worth storing because
  // people connect a different account than they signed in with more often
  // than you'd think — and then wonder where their events went.
  googleId String
  email    String

  // Sealed with a key derived from AUTH_SECRET; see src/lib/google-tokens.ts.
  // Encrypted rather than plain because AUTH_SECRET and DATABASE_URL live in
  // different places, so the realistic leak — a preview branch of the database,
  // a backup, a query log — hands over this table without the key.
  refreshToken String
  // A cache, not a source of truth. Saves a refresh round-trip when several
  // syncs fire in a burst across separate serverless instances, where an
  // in-process cache would miss every time.
  accessToken          String?
  accessTokenExpiresAt DateTime?

  // What Google actually granted, not what we asked for. The consent screen
  // lets people untick individual permissions, and a connection missing the
  // calendar scope has to be refused at the door rather than discovered on the
  // first push.
  scope String

  // The secondary calendar we created. Writing to a calendar of our own rather
  // than their primary makes disconnect one DELETE instead of a sweep, keeps
  // our deterministic event ids from colliding with anything they already have,
  // and lets them hide or recolour it independently. Null only between the
  // token exchange and the first successful calendars.insert.
  calendarId String?

  status      String    @default("ACTIVE") // ACTIVE | REVOKED
  lastError   String?
  connectedAt DateTime  @default(now())
  syncedAt    DateTime?
  updatedAt   DateTime  @updatedAt

  items GoogleCalendarItem[]
}

// What we've pushed, and what it looked like when we pushed it. A mapping table
// rather than a googleEventId column on Workout, because a client and their
// trainer may both sync the same workout — two calendars, two event ids, which
// one column can't hold. It also gives change detection a home: Workout has no
// updatedAt, and sync bookkeeping has no business on a coach's session anyway.
model GoogleCalendarItem {
  id String @id @default(cuid())

  connectionId String
  connection   GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  source   String // WORKOUT | EVENT
  sourceId String

  googleEventId String

  // A copy of the local-midnight date we last pushed this at. The reconcile
  // pass works over a date window, and without this a row that was deleted
  // locally — or moved out of the window — could never be found again to delete
  // remotely.
  date DateTime

  // Hash of the payload we last sent. Nothing to push when it matches, which is
  // the overwhelmingly common case and the reason a sync usually costs zero
  // Google calls.
  hash String

  syncedAt DateTime @default(now())

  @@unique([connectionId, source, sourceId])
  @@index([connectionId, date])
}

// One row per "email me a reset link". Short-lived and single-use — see
// src/lib/reset-token.ts, which owns every rule about them.
model PasswordResetToken {
  id String @id @default(cuid())

  // SHA-256 of the token that went out in the email, never the token itself.
  // A leaked database is then a list of useless hashes rather than a set of
  // live account-takeover links. The index is what the lookup runs against,
  // so the raw token is never compared against anything in the clear.
  tokenHash String @unique

  userId String
  user   User   @relation("UserResets", fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  // Set the moment a token is spent. Kept rather than deleted so a second click
  // on the same link can say "already used" instead of the indistinguishable
  // "never existed", and so the rate limit below counts real requests.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Supports both reads: "is this user asking too often" (the rate limit) and
  // "invalidate everything else they have outstanding" (on a successful reset).
  @@index([userId, createdAt])
}

// One row per sign-in attempt, successful or not. Read only by the owner admin
// area — nothing in the app's own flows depends on it, which is why writing it
// is best-effort (see src/lib/login-log.ts).
model LoginEvent {
  id String @id @default(cuid())

  // The address as typed at the prompt, kept even when no account matched: an
  // attempt against an email we don't know is exactly what's worth seeing.
  email     String
  method    String   // PASSWORD | GOOGLE
  outcome   String   // SUCCESS | NO_ACCOUNT | BAD_PASSWORD | GOOGLE_ONLY | GOOGLE_UNVERIFIED
  createdAt DateTime @default(now())

  // Null when the attempt never resolved to an account. Nulled rather than
  // cascaded on delete so the trail outlives the row it points at — `email`
  // above is what still identifies a deleted account's attempts.
  userId String?
  user   User?   @relation("UserLogins", fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model Workout {
  id            String    @id @default(cuid())
  title         String
  notes         String?
  scheduledDate DateTime
  status        String    @default("ASSIGNED") // ASSIGNED | COMPLETED
  // What kind of training this session is. STRENGTH is the default because it's
  // what every workout written before this column existed actually was. Copied
  // from the template or program slot a session is assigned from, so a climbing
  // template can't materialise into strength sessions.
  discipline    String    @default("STRENGTH") // STRENGTH | CARDIO | CLIMBING | MOBILITY | OTHER
  completedAt   DateTime?
  rpe           Int? // session rating of perceived exertion, 1-10
  clientComment String?
  createdAt     DateTime  @default(now())

  // The coach's answer to a finished session — the other half of rpe and
  // clientComment above, which is why all four sit on Workout rather than in a
  // messages table. A session gets one response from one coach and it belongs
  // to that session; threading it would be a different feature.
  //
  // The athlete sees both on their own copy of the session. Nothing here is a
  // private note: if that's ever wanted it needs its own column, because a
  // column that is sometimes shown and sometimes not is how private notes end
  // up in front of the person they were about.
  coachReaction    String? // one of COACH_REACTIONS in src/lib/constants.ts
  coachNote        String?
  // When the coach last responded, so the athlete's page can say "2h ago" and
  // so "has this been responded to" is one nullable check rather than an OR
  // over two columns that can each independently be cleared.
  coachRespondedAt DateTime?

  // Time of day, as minutes from midnight (0-1439). Null means no time was set,
  // which is every workout written before the calendar existed and every one
  // created by assigning a template or a program. Deliberately the same shape
  // and name as CalendarEvent.startMinute so the calendar can merge and sort
  // both with one comparator.
  startMinute Int?

  clientId String
  client   User   @relation("ClientWorkouts", fields: [clientId], references: [id], onDelete: Cascade)

  trainerId String
  trainer   User   @relation("TrainerWorkouts", fields: [trainerId], references: [id], onDelete: Cascade)

  exercises Exercise[]
  feedItems FeedItem[]

  @@index([clientId, scheduledDate])
  // The calendar's month query is trainer-scoped over a date range, so it can't
  // use the clientId index above.
  @@index([trainerId, scheduledDate])
}

model Exercise {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  // Prescription (what the trainer programs). Free-form strings so coaches can
  // write ranges and notation like "8-10", "60%", tempo "30X1", rest "90s".
  name   String
  sets   String?
  reps   String?
  weight String? // actual load lifted ("100kg"); `load` stays for %/RPE
  load   String?
  tempo  String?
  rest   String?
  notes  String?
  order  Int     @default(0)
  // WARMUP | MAIN | COOLDOWN. A grouping label only — `order` stays global
  // 1..N across the whole session, so anything that reorders rows has to
  // renumber the workout, not one section.
  section String @default("MAIN")

  // Client-logged actuals. Free-form strings for the same reason the
  // prescription above is: "3 of 4" and "6,6,6,5" are both honest answers to
  // what happened, and a number column would force the athlete to round one of
  // them into a lie.
  resultSets String?
  resultReps String?
  resultLoad String?
  done       Boolean @default(false)
}

model FeedItem {
  id        String   @id @default(cuid())
  type      String   @default("WORKOUT_COMPLETED")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  trainerId String
  trainer   User   @relation("TrainerFeed", fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("ClientFeed", fields: [clientId], references: [id], onDelete: Cascade)

  // Exactly one of these is set, chosen by `type`. Both are nullable because a
  // feed item is now either kind of event — workoutId was NOT NULL when a
  // finished session was the only thing that could reach the feed.
  workoutId String?
  workout   Workout? @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  nutritionLogId String?
  nutritionLog   NutritionLog? @relation(fields: [nutritionLogId], references: [id], onDelete: Cascade)

  // The unique index is what stops a day's log filling the feed. An athlete
  // saves their log four or five times over a day; each save must find the
  // same feed row rather than add one. Postgres allows unlimited NULLs in a
  // unique index, so every WORKOUT_COMPLETED row — all of them null here —
  // coexists untouched, and the save becomes a single upsert keyed on this
  // column: atomic, with no read-then-write window for two saves to race
  // through. A workout can't use the same trick, and doesn't need to: it
  // completes once.
  @@unique([nutritionLogId])
  @@index([trainerId, read])
}

// A reusable, client-agnostic workout the trainer builds once and can drop onto
// any client (or slot into a program). Assigning one copies its rows into a real
// Workout — templates themselves are never scheduled or logged.
model WorkoutTemplate {
  id         String   @id @default(cuid())
  title      String
  notes      String?
  discipline String   @default("STRENGTH") // mirrors Workout.discipline
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trainerId String
  trainer   User   @relation("TrainerTemplates", fields: [trainerId], references: [id], onDelete: Cascade)

  exercises TemplateExercise[]
  slots     ProgramSlot[]

  @@index([trainerId])
}

// Mirrors the prescription half of Exercise (no client-logged actuals).
model TemplateExercise {
  id         String          @id @default(cuid())
  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name    String
  sets    String?
  reps    String?
  weight  String? // mirrors Exercise.weight
  load    String?
  tempo   String?
  rest    String?
  notes   String?
  order   Int     @default(0)
  section String  @default("MAIN") // mirrors Exercise.section
}

// A multi-week block. Assigning it materializes each slot into a dated Workout.
model Program {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  weeks     Int      @default(4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainerId String
  trainer   User   @relation("TrainerPrograms", fields: [trainerId], references: [id], onDelete: Cascade)

  slots ProgramSlot[]

  @@index([trainerId])
}

// "On week W, day D, do this saved workout." Rest days simply have no slot.
model ProgramSlot {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  week Int
  day  Int // 1-7

  @@unique([programId, week, day])
}

// Every exercise name this trainer has actually programmed — preset or not.
// Written automatically when a workout or template is saved. Powers the
// picker's "Recent" list and, for names that aren't in the shipped preset
// catalogue, the trainer's "My exercises". Whether a row counts as custom is
// computed at read time rather than stored, so promoting a name into the
// preset list later moves it out of everyone's "My exercises" on its own.
//
// Names on Exercise/TemplateExercise stay denormalized strings with no foreign
// key to here, so deleting a row never touches programming already written.
model TrainerExercise {
  id String @id @default(cuid())

  trainerId String
  trainer   User   @relation("TrainerExercises", fields: [trainerId], references: [id], onDelete: Cascade)

  name       String // display form, as first typed
  nameKey    String // lowercased, whitespace-collapsed — the dedupe key
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  // Nullable, not defaulted: rows are created automatically by
  // recordExerciseNames, so "no one has classified this" is a real state and
  // distinct from "someone chose Strength". A null reads as the discipline of
  // the preset category the name belongs to, and OTHER if it belongs to none.
  discipline String? // STRENGTH | CARDIO | CLIMBING | MOBILITY | OTHER

  // Trainer-supplied demo media, shown to the client instead of the generic
  // YouTube search. mediaKind isn't cosmetic: UPLOAD means we own the blob and
  // must delete it when the media is replaced or removed.
  mediaUrl  String?
  mediaKind String? // UPLOAD | LINK

  @@unique([trainerId, nameKey])
  @@index([trainerId, lastUsedAt])
}

// One nutrition plan model serves both roles: clientId null = a library template
// the trainer reuses; clientId set = a snapshot assigned to that client.
model NutritionPlan {
  id    String  @id @default(cuid())
  title String
  notes String?

  // Optional daily targets, shown alongside the summed food totals.
  targetCalories Int?
  targetProtein  Int?
  targetCarbs    Int?
  targetFat      Int?

  assignedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  trainerId String
  trainer   User   @relation("TrainerNutrition", fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String?
  client   User?   @relation("ClientNutrition", fields: [clientId], references: [id], onDelete: Cascade)

  meals Meal[]

  @@index([trainerId])
  @@index([clientId])
}

model Meal {
  id     String        @id @default(cuid())
  planId String
  plan   NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  name  String // "Breakfast"
  notes String?
  order Int     @default(0)

  foods Food[]
}

model Food {
  id     String @id @default(cuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  name     String
  // "1 cup", "150 g" — and, when a preset was scaled, "2 × 1 medium (200 g)".
  // There is no servings column on purpose: a saved plan is a snapshot handed
  // to an athlete, not a formula. Storing a multiplier would mean every place
  // that sums macros has to remember to apply it, and one missed call site is
  // a silently wrong daily total. The builder recovers the multiplier from this
  // string instead (see food-presets.ts).
  quantity String?
  calories Int?
  protein  Int?
  carbs    Int?
  fat      Int?
  order    Int     @default(0)
}

// What the athlete actually ate on a day — the other half of NutritionPlan,
// which is only ever what the coach prescribed.
//
// A separate tree rather than a reused NutritionPlan with some flag, because a
// plan is defined by the things a log has no business carrying: target macros,
// assignedAt, and a nullable clientId that means "library template". Every
// existing plan query would need a new filter to keep diaries out, and the one
// call site that got missed would show an athlete's log back to them as their
// prescription.
model NutritionLog {
  id String @id @default(cuid())

  clientId String
  client   User   @relation("ClientNutritionLogs", fields: [clientId], references: [id], onDelete: Cascade)

  // Local-midnight, the same convention as Workout.scheduledDate — this is the
  // athlete's day, resolved the same way every other date in the app is.
  // Contrast DigestRun.day, which is a String precisely because it isn't.
  date DateTime

  // The nutrition analogue of Workout.clientComment: "travelling, ate out
  // twice". The context that makes the numbers legible to a coach.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foods     LoggedFood[]
  feedItems FeedItem[]

  // Serves the save's upsert and the client's own day lookup both. One day per
  // client, so re-saving edits the day instead of stacking another one.
  @@unique([clientId, date])
  // The digest asks "what changed since I last ran", which the unique index
  // above can't answer — its second column is the day logged *for*, not the
  // moment it was touched.
  @@index([clientId, updatedAt])
}

// One food in a day's log. Flat, with the meal as a label on the row rather
// than a Meal table between this and NutritionLog — the opposite shape to
// Plan → Meal → Food, and on purpose:
//
//   - A meal row's only content would be a string the athlete typed. Saving is
//     a wholesale delete-and-recreate (the same pattern updateNutritionTemplate
//     uses), so those rows would be destroyed and remade on every save and
//     never hold identity across one.
//   - Decisively: a barcode scan produces exactly one food. With meals as rows,
//     a scanned item has to choose a parent before it can exist at all, which
//     puts a dialog in front of the fastest path in the feature.
//
// sumMacros() in nutrition-form.ts still works unchanged — pass the day as a
// single pseudo-meal, `sumMacros([{ foods: log.foods }])`.
model LoggedFood {
  id    String       @id @default(cuid())
  logId String
  log   NutritionLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  // Free-form: "Breakfast", "Post-session", or empty. A grouping label for
  // reading the day back, not an ordering key — `order` stays global across
  // the whole log, exactly as Exercise.order does across a whole workout.
  meal String @default("")

  name String
  // Same contract as Food.quantity, including the "2 × 1 medium (200 g)" form
  // a scaled preset produces. Deliberately no servings column, for the reason
  // spelled out on that column.
  quantity String?
  calories Int?
  protein  Int?
  carbs    Int?
  fat      Int?
  order    Int     @default(0)

  // MANUAL | PRESET | BARCODE | PHOTO — see FOOD_SOURCE in constants.ts. The
  // only signal the scanning features will ever produce about whether they get
  // used, and a coach reads "off a barcode" differently from "she guessed".
  source String @default("MANUAL")
}

// One row per trainer per day the digest has been claimed for. Its own table
// for the same reason GoogleCalendarConnection is one: nothing reads it unless
// a digest is actually running, so it stays off the User row that every
// authenticated request loads in full.
//
// The unique index below is the mutex, not just a constraint. The cron fires
// hourly and can retry; create() either wins the day or throws P2002, which
// isUniqueViolation() in src/lib/db.ts already exists to catch. That is a
// claim-then-send, structurally the same move syncIfStale makes when it uses a
// where-guard as both the throttle and the lock.
model DigestRun {
  id String @id @default(cuid())

  trainerId String
  trainer   User   @relation("TrainerDigests", fields: [trainerId], references: [id], onDelete: Cascade)

  // The trainer's own calendar day, "2026-08-07". A String rather than the
  // local-midnight DateTime used everywhere else in this schema, and that
  // asymmetry with NutritionLog.date is the point: this day is resolved in the
  // *trainer's* zone on a server that may be in another one, so a DateTime
  // would be ambiguous in exactly the way CalendarEvent's comment warns about.
  day String

  claimedAt DateTime  @default(now())
  sentAt    DateTime?

  // What went out, so a quiet digest is distinguishable from a broken one.
  workouts Int     @default(0)
  logs     Int     @default(0)
  ok       Boolean @default(false)

  @@unique([trainerId, day])
  @@index([trainerId, claimedAt])
}

// A trainer's own calendar entry: consults, check-in calls, admin blocks —
// anything that isn't a programmed session. Workouts stay in Workout and are
// never mirrored here; the calendar merges the two at read time.
model CalendarEvent {
  id    String  @id @default(cuid())
  title String
  notes String?

  // Local-midnight date, exactly like Workout.scheduledDate. The app has no
  // timezone handling anywhere, so the day a thing happens on is stored as a
  // date and the time of day as a plain minute count — never as one wall-clock
  // DateTime, which would slide a 9pm entry onto the next day the moment the
  // server's zone differs from the trainer's.
  date        DateTime
  startMinute Int? // 0-1439; null = an all-day entry
  endMinute   Int? // null on a timed entry just means no fixed finish

  // SESSION | CONSULT | CHECKIN | PERSONAL, mirrored in src/lib/constants.ts.
  kind String @default("SESSION")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainerId String
  trainer   User   @relation("TrainerEvents", fields: [trainerId], references: [id], onDelete: Cascade)

  // An event can be about a client, or purely the trainer's own time.
  clientId String?
  client   User?   @relation("ClientEvents", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([trainerId, date])
  @@index([clientId])
}

// A conversation. The first thing in this app that isn't attached to a session,
// a day or a plan — everything a coach and an athlete said to each other before
// now hung off the thing it was about (Workout.clientComment, Workout.coachNote).
//
// One model covers 1:1 and group, distinguished by `kind` and by how many
// participants there are. The alternative — a DirectThread and a GroupThread —
// would double every read in src/lib/messaging.ts to answer questions ("what's
// unread", "what's newest") that don't care which kind a thread is.
model Thread {
  id    String  @id @default(cuid())
  kind  String  @default("DIRECT") // DIRECT | GROUP
  // Null on a DIRECT thread: its name is whoever else is in it, which depends
  // on who's reading. Only a group has a name of its own.
  title String?

  // "<smaller userId>:<larger userId>" on a DIRECT thread, null on a GROUP. The
  // unique index is what stops a coach and an athlete opening the same
  // conversation twice from two devices — the pair is the identity, and sorting
  // the two ids is what makes the key the same from both directions.
  //
  // Postgres allows unlimited NULLs in a unique index, so every group coexists
  // here untouched. The same move FeedItem makes with @@unique([nutritionLogId]),
  // and for the same reason: it turns "find or create" into one write with no
  // read-then-write window for two devices to race through.
  directKey String? @unique

  // Bumped on every send. Denormalised so the thread list sorts on a column
  // instead of an aggregate over messages — the list is the first screen of the
  // tab and it loads on every visit.
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  // Every thread is owned by exactly one coach, including a group. An athlete
  // can reply but can't start one, so there is no thread in the app that isn't
  // reachable from some trainer — which is also what makes the ownership check
  // in every action a single comparison.
  trainerId String
  trainer   User   @relation("TrainerThreads", fields: [trainerId], references: [id], onDelete: Cascade)

  participants ThreadParticipant[]
  messages     Message[]

  @@index([trainerId, lastMessageAt])
}

model ThreadParticipant {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("UserThreads", fields: [userId], references: [id], onDelete: Cascade)

  // Null means never opened. Unread is then "messages newer than this", which
  // is one timestamp comparison — rather than a read-receipt row per message
  // per person, which is a table that grows with the product of both and
  // answers no question this app asks.
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([threadId, userId])
  // The badge query starts from "which threads is this user in", on every
  // authenticated page load of either role.
  @@index([userId])
}

model Message {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  body String

  // When the email copy went out, and null when it didn't. The in-app message
  // is the real one and email is a copy, so a mail outage has to be visible
  // rather than assumed either way — the thread says "also emailed" only when
  // this is set.
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([threadId, createdAt])
}

// A message the coach writes once and the app sends on a schedule — the
// motivational drip. Deliberately not a Message row with a future date: an
// unsent Message would be visible to every read in messaging.ts and would have
// to be filtered out of each one, and the filter that got missed is a coach's
// draft appearing in an athlete's inbox a week early.
model Broadcast {
  id        String @id @default(cuid())
  trainerId String
  trainer   User   @relation("TrainerBroadcasts", fields: [trainerId], references: [id], onDelete: Cascade)

  // The coach's own name for it in the list ("Monday kick-off"). Never sent.
  label String
  body  String

  // 0-23 in the trainer's own zone, and deliberately the same encoding as
  // User.digestHour rather than the minutes-from-midnight the calendar uses.
  // The reason is the same one spelled out there: the cron ticks hourly, so a
  // minute field would promise a precision it cannot keep.
  hour Int
  // 0=Sunday .. 6=Saturday, sorted and deduped by parseWeekdays in
  // src/lib/constants.ts. An Int[] rather than a bitmask so the stored value
  // and the checkbox row read the same in a query, a log and a psql session.
  weekdays Int[]

  audience String  @default("ALL") // ALL | PICKED
  active   Boolean @default(true)
  // Whether a copy also reaches their inbox. It always lands in the thread —
  // that's what makes this a message rather than a mailshot, and it's why an
  // athlete can reply to one.
  alsoEmail Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients BroadcastRecipient[]
  runs       BroadcastRun[]

  @@index([trainerId])
}

// Only meaningful when audience is PICKED. An ALL broadcast resolves its
// recipients at send time instead, so a client added on Thursday is included in
// Friday's send without the coach editing anything.
model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  clientId    String
  client      User      @relation("ClientBroadcasts", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, clientId])
}

model BroadcastRun {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  // The trainer's own calendar day, "2026-08-10". A String for exactly the
  // reason DigestRun.day is one, and worth repeating because it looks like an
  // inconsistency: this day is resolved in the *trainer's* zone on a server
  // that may be in another, so a local-midnight DateTime would be ambiguous
  // about which midnight it meant.
  day String

  claimedAt DateTime  @default(now())
  sentAt    DateTime?
  sent      Int       @default(0)
  ok        Boolean   @default(false)

  // The mutex, not merely a constraint — identical in role to DigestRun's.
  // The cron fires hourly and can retry; create() either wins the day or
  // throws P2002, which isUniqueViolation() in src/lib/db.ts already exists to
  // recognise. Without it, a scheduler that retries sends the same
  // motivational message twice.
  @@unique([broadcastId, day])
}
