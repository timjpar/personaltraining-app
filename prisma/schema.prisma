// Personal training app — data model
// Postgres everywhere: the same provider locally and in production, so what
// works in dev is what deploys. Note: role/status/type stay String fields with
// app-level constants (see src/lib/constants.ts) rather than native enums.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  email String @unique
  // Null for accounts that only ever signed in with Google. Every read has to
  // treat "no password" as a real state, not a broken row.
  passwordHash String?
  // Google's `sub` claim — stable for the lifetime of the Google account, and
  // unlike the email address it never gets reassigned, so it's the identity we
  // match on once an account is linked.
  googleId String? @unique
  name     String
  role     String   @default("CLIENT") // TRAINER | CLIENT
  createdAt DateTime @default(now())

  // How this account came to exist. Existing rows all default to SELF, which is
  // right for everyone who registered but wrong for clients a trainer added —
  // only new rows are accurate.
  signupSource String @default("SELF") // SELF | GOOGLE | TRAINER
  // Denormalised from the newest successful LoginEvent so the admin list can
  // sort and display "last seen" without a per-row subquery.
  lastLoginAt DateTime?

  // A client belongs to one trainer (self-relation).
  trainerId String?
  trainer   User?   @relation("TrainerClients", fields: [trainerId], references: [id])
  clients   User[]  @relation("TrainerClients")

  workoutsAsClient  Workout[] @relation("ClientWorkouts")
  workoutsAsTrainer Workout[] @relation("TrainerWorkouts")

  feedItemsAsTrainer FeedItem[] @relation("TrainerFeed")
  feedItemsAsClient  FeedItem[] @relation("ClientFeed")

  // Reusable, client-agnostic building blocks a trainer owns.
  templates          WorkoutTemplate[] @relation("TrainerTemplates")
  programs           Program[]         @relation("TrainerPrograms")
  exerciseNames      TrainerExercise[] @relation("TrainerExercises")
  nutritionTemplates NutritionPlan[]   @relation("TrainerNutrition")
  // Nutrition plans assigned down to this user (as a client).
  nutritionPlans     NutritionPlan[]   @relation("ClientNutrition")

  // The trainer's own calendar entries, and the ones that name this user as the
  // client they're about.
  eventsAsTrainer CalendarEvent[] @relation("TrainerEvents")
  eventsAsClient  CalendarEvent[] @relation("ClientEvents")

  logins LoginEvent[] @relation("UserLogins")
}

// One row per sign-in attempt, successful or not. Read only by the owner admin
// area — nothing in the app's own flows depends on it, which is why writing it
// is best-effort (see src/lib/login-log.ts).
model LoginEvent {
  id String @id @default(cuid())

  // The address as typed at the prompt, kept even when no account matched: an
  // attempt against an email we don't know is exactly what's worth seeing.
  email     String
  method    String   // PASSWORD | GOOGLE
  outcome   String   // SUCCESS | NO_ACCOUNT | BAD_PASSWORD | GOOGLE_ONLY | GOOGLE_UNVERIFIED
  createdAt DateTime @default(now())

  // Null when the attempt never resolved to an account. Nulled rather than
  // cascaded on delete so the trail outlives the row it points at — `email`
  // above is what still identifies a deleted account's attempts.
  userId String?
  user   User?   @relation("UserLogins", fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model Workout {
  id            String    @id @default(cuid())
  title         String
  notes         String?
  scheduledDate DateTime
  status        String    @default("ASSIGNED") // ASSIGNED | COMPLETED
  completedAt   DateTime?
  rpe           Int? // session rating of perceived exertion, 1-10
  clientComment String?
  createdAt     DateTime  @default(now())

  // Time of day, as minutes from midnight (0-1439). Null means no time was set,
  // which is every workout written before the calendar existed and every one
  // created by assigning a template or a program. Deliberately the same shape
  // and name as CalendarEvent.startMinute so the calendar can merge and sort
  // both with one comparator.
  startMinute Int?

  clientId String
  client   User   @relation("ClientWorkouts", fields: [clientId], references: [id], onDelete: Cascade)

  trainerId String
  trainer   User   @relation("TrainerWorkouts", fields: [trainerId], references: [id], onDelete: Cascade)

  exercises Exercise[]
  feedItems FeedItem[]

  @@index([clientId, scheduledDate])
  // The calendar's month query is trainer-scoped over a date range, so it can't
  // use the clientId index above.
  @@index([trainerId, scheduledDate])
}

model Exercise {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  // Prescription (what the trainer programs). Free-form strings so coaches can
  // write ranges and notation like "8-10", "60%", tempo "30X1", rest "90s".
  name   String
  sets   String?
  reps   String?
  weight String? // actual load lifted ("100kg"); `load` stays for %/RPE
  load   String?
  tempo  String?
  rest   String?
  notes  String?
  order  Int     @default(0)
  // WARMUP | MAIN | COOLDOWN. A grouping label only — `order` stays global
  // 1..N across the whole session, so anything that reorders rows has to
  // renumber the workout, not one section.
  section String @default("MAIN")

  // Client-logged actuals.
  resultReps String?
  resultLoad String?
  done       Boolean @default(false)
}

model FeedItem {
  id        String   @id @default(cuid())
  type      String   @default("WORKOUT_COMPLETED")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  trainerId String
  trainer   User   @relation("TrainerFeed", fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("ClientFeed", fields: [clientId], references: [id], onDelete: Cascade)

  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([trainerId, read])
}

// A reusable, client-agnostic workout the trainer builds once and can drop onto
// any client (or slot into a program). Assigning one copies its rows into a real
// Workout — templates themselves are never scheduled or logged.
model WorkoutTemplate {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainerId String
  trainer   User   @relation("TrainerTemplates", fields: [trainerId], references: [id], onDelete: Cascade)

  exercises TemplateExercise[]
  slots     ProgramSlot[]

  @@index([trainerId])
}

// Mirrors the prescription half of Exercise (no client-logged actuals).
model TemplateExercise {
  id         String          @id @default(cuid())
  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name    String
  sets    String?
  reps    String?
  weight  String? // mirrors Exercise.weight
  load    String?
  tempo   String?
  rest    String?
  notes   String?
  order   Int     @default(0)
  section String  @default("MAIN") // mirrors Exercise.section
}

// A multi-week block. Assigning it materializes each slot into a dated Workout.
model Program {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  weeks     Int      @default(4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainerId String
  trainer   User   @relation("TrainerPrograms", fields: [trainerId], references: [id], onDelete: Cascade)

  slots ProgramSlot[]

  @@index([trainerId])
}

// "On week W, day D, do this saved workout." Rest days simply have no slot.
model ProgramSlot {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  week Int
  day  Int // 1-7

  @@unique([programId, week, day])
}

// Every exercise name this trainer has actually programmed — preset or not.
// Written automatically when a workout or template is saved. Powers the
// picker's "Recent" list and, for names that aren't in the shipped preset
// catalogue, the trainer's "My exercises". Whether a row counts as custom is
// computed at read time rather than stored, so promoting a name into the
// preset list later moves it out of everyone's "My exercises" on its own.
//
// Names on Exercise/TemplateExercise stay denormalized strings with no foreign
// key to here, so deleting a row never touches programming already written.
model TrainerExercise {
  id String @id @default(cuid())

  trainerId String
  trainer   User   @relation("TrainerExercises", fields: [trainerId], references: [id], onDelete: Cascade)

  name       String // display form, as first typed
  nameKey    String // lowercased, whitespace-collapsed — the dedupe key
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  // Trainer-supplied demo media, shown to the client instead of the generic
  // YouTube search. mediaKind isn't cosmetic: UPLOAD means we own the blob and
  // must delete it when the media is replaced or removed.
  mediaUrl  String?
  mediaKind String? // UPLOAD | LINK

  @@unique([trainerId, nameKey])
  @@index([trainerId, lastUsedAt])
}

// One nutrition plan model serves both roles: clientId null = a library template
// the trainer reuses; clientId set = a snapshot assigned to that client.
model NutritionPlan {
  id    String  @id @default(cuid())
  title String
  notes String?

  // Optional daily targets, shown alongside the summed food totals.
  targetCalories Int?
  targetProtein  Int?
  targetCarbs    Int?
  targetFat      Int?

  assignedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  trainerId String
  trainer   User   @relation("TrainerNutrition", fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String?
  client   User?   @relation("ClientNutrition", fields: [clientId], references: [id], onDelete: Cascade)

  meals Meal[]

  @@index([trainerId])
  @@index([clientId])
}

model Meal {
  id     String        @id @default(cuid())
  planId String
  plan   NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  name  String // "Breakfast"
  notes String?
  order Int     @default(0)

  foods Food[]
}

model Food {
  id     String @id @default(cuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  name     String
  // "1 cup", "150 g" — and, when a preset was scaled, "2 × 1 medium (200 g)".
  // There is no servings column on purpose: a saved plan is a snapshot handed
  // to an athlete, not a formula. Storing a multiplier would mean every place
  // that sums macros has to remember to apply it, and one missed call site is
  // a silently wrong daily total. The builder recovers the multiplier from this
  // string instead (see food-presets.ts).
  quantity String?
  calories Int?
  protein  Int?
  carbs    Int?
  fat      Int?
  order    Int     @default(0)
}

// A trainer's own calendar entry: consults, check-in calls, admin blocks —
// anything that isn't a programmed session. Workouts stay in Workout and are
// never mirrored here; the calendar merges the two at read time.
model CalendarEvent {
  id    String  @id @default(cuid())
  title String
  notes String?

  // Local-midnight date, exactly like Workout.scheduledDate. The app has no
  // timezone handling anywhere, so the day a thing happens on is stored as a
  // date and the time of day as a plain minute count — never as one wall-clock
  // DateTime, which would slide a 9pm entry onto the next day the moment the
  // server's zone differs from the trainer's.
  date        DateTime
  startMinute Int? // 0-1439; null = an all-day entry
  endMinute   Int? // null on a timed entry just means no fixed finish

  // SESSION | CONSULT | CHECKIN | PERSONAL, mirrored in src/lib/constants.ts.
  kind String @default("SESSION")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainerId String
  trainer   User   @relation("TrainerEvents", fields: [trainerId], references: [id], onDelete: Cascade)

  // An event can be about a client, or purely the trainer's own time.
  clientId String?
  client   User?   @relation("ClientEvents", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([trainerId, date])
  @@index([clientId])
}
